#!/bin/sh
# BROWSER for a Claude Code session running the browser pane: hands each URL to the pane, and
# opens it the usual way when the pane's helper cannot take it.
here=$(dirname "$0")

for url in "$@"; do
  if [ -S "$CLAUDE_BROWSER_PANE_SOCKET" ] && node "$here/../helper/open.mjs" "$url"; then
    continue
  fi

  # Without BROWSER, so a generic xdg-open does not hand the link straight back here.
  env -u BROWSER -u CLAUDE_BROWSER_PANE_SOCKET xdg-open "$url"
done
